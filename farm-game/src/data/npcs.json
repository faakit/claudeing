    "events": [
      {
        "hearts": 2,
        "id": "shelf",
        "title": "The back shelf",
        "lines": [
          "Come here, I want to show you something.",
          "I always keep the best seeds on the back shelf.",
          "Take these. Consider it a welcome gift."
        ],
        "reward": {
          "item": "cauliflower_seed",
          "qty": 5
        }
      },
      {
        "hearts": 4,
        "id": "ledger",
        "title": "Mara's ledger",
        "lines": [
          "This is my ledger: every family that left the valley.",
          "I haven't crossed out a single name. Not one.",
          "Here. For staying. That's rarer than you'd think."
        ],
        "reward": {
          "gold": 400
        }
      },
      {
        "hearts": 5,
        "id": "best",
        "title": "Best customer",
        "lines": [
          "Five hearts! I made you something.",
          "It is a keg, from my own workshop. Use it well.",
          "You have made this valley feel like home."
        ],
        "reward": {
          "item": "keg",
          "qty": 1
        }
      }
    ]
