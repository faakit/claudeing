    "events": [
      {
        "hearts": 2,
        "id": "lake",
        "title": "The quiet lake",
        "lines": [
          "Do you hear that? Nothing. That is the point.",
          "Fishing is listening. The fish tell you when.",
          "Here, a few baits. Pay attention, friend."
        ],
        "reward": {
          "item": "bait",
          "qty": 8
        }
      },
      {
        "hearts": 4,
        "id": "heron",
        "replaces": "secret",
        "title": "The Heron",
        "when": {
          "place": "weir",
          "max": 2
        },
        "lines": [
          "Come see the Heron with me sometime. Dad built her the year I was born.",
          "His initials are cut by the bow. I scrape round them every spring.",
          "She'll float again. Here, these were biting yesterday."
        ],
        "reward": {
          "item": "catfish",
          "qty": 2
        }
      },
      {
        "hearts": 4,
        "id": "heron",
        "replaces": "secret",
        "title": "The Heron",
        "when": {
          "place": "weir",
          "min": 3
        },
        "lines": [
          "Seven years on the mud, and now she just floats. Dad built her.",
          "His initials are by the bow. I touch them for luck before I cast.",
          "First catch off her deck. They're yours."
        ],
        "reward": {
          "item": "catfish",
          "qty": 2
        }
      },
      {
        "hearts": 5,
        "id": "legend",
        "title": "The golden salmon",
        "lines": [
          "They say a golden salmon swims in these waters.",
          "I never caught it. Maybe you will.",
          "Keep these, you earned them."
        ],
        "reward": {
          "item": "salmon",
          "qty": 2
        }
      }
    ]
  },
  "rosa": {
    "name": "Rosa",
    "role": "friend",
    "map": "farm",
    "tx": 16,
    "ty": 12,
    "facing": "left",
    "tint": "#c9a0e8",
    "blurb": "Neighbour. Knows soil.",
    "loves": ["pumpkin", "wild_berry", "cauliflower", "pumpkin_pie"],
    "likes": ["parsnip", "corn", "yam", "jam", "pickles"],
    "dislikes": ["holly", "winter_root"],
    "lines": {
      "stranger": [
        "Oh, you are the new farmer!",
        "The soil remembers. Treat it kindly.",
        "Welcome to the valley.",
        {
          "text": "Ilse's fields went to straw. Give them a week.",
          "when": {
            "stat": "valley.farmGreen",
            "max": 0
          }
        },
        {
          "text": "Two buckets a day, to my grandmother's last cherry tree.",
          "when": {
            "place": "orchard",
            "max": 2
          }
        }
      ],
      "friend": [
        "Water early, sleep well.",
        "Fertilizer makes the pretty ones.",
        "Sprinklers save so many mornings.",
        {
          "text": "Ilse and I talked over that fence every morning for forty years.",
          "when": {
            "place": "orchard",
            "max": 2
          }
        }
      ],
      "close": [
        "Take this, it will help your crops.",
        "I love watching your farm grow.",
        "You have the touch. Truly.",
        {
          "text": "Grandmother's orchard died standing. The roots didn't. I check.",
          "when": {
            "place": "orchard",
            "max": 2
          }
        }
      ],
      "rain": ["Rain! The valley drinks it all by noon.", "Rain day. Rest your back."]
    },
