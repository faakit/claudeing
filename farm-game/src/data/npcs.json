    "loves": ["corn", "pumpkin_pie", "berry_tart", "honey"],
    "likes": ["potato", "egg", "milk", "apple"],
    "dislikes": ["holly", "fiber"],
    "lines": {
      "stranger": [
        "You rebuilt our house? With river wood? I don't know what to say.",
        "Three generations of Marls ran that mill. I'm the fourth.",
        "Mara kept my room. Of course she did.",
        "Listen. That's the wheel. I'd forgotten the sound."
      ],
      "friend": [
        "Ivo's greasing the wheel. He sings to it. Don't tell him I told you.",
        "Bring me corn in the fall and I'll show you what a mill is for.",
        "Mara says you came with nothing but a key under a pot."
      ],
      "close": [
        "Every turn of that wheel, I think of you hauling logs up the bank.",
        "We're staying. I needed to say it out loud once.",
        "The river took us away. You brought it back, and us with it."
      ],
      "rain": [
        "Rain on the race. The wheel likes it.",
        "Good day for staying in and mending sacks."
      ]
    },
