{
  "mara": {
    "name": "Mara",
    "role": "shop",
    "map": "town",
    "tx": 8,
    "ty": 10,
    "facing": "down",
    "tint": "#ffb08a",
    "blurb": "Runs the General Store.",
    "loves": ["daffodil", "jam", "wild_sunflower"],
    "likes": ["tomato", "melon", "pickles", "egg", "milk", "berry_tart"],
    "dislikes": ["fiber", "mushroom"],
    "lines": {
      "stranger": [
        "Welcome to the General Store!",
        "New face? Seeds are on the shelf.",
        "Mind the step. Prices are fair here.",
        {
          "text": "I keep the lights on, so folk know where to come back to.",
          "when": {
            "place": "market",
            "max": 2
          }
        },
        {
          "text": "Saturdays, that field was all stalls. You'd have loved it.",
          "when": {
            "place": "market",
            "max": 2
          }
        }
      ],
      "friend": [
        "Good to see you again!",
        "Your crops are the first fresh things on my shelf in years.",
        "I saved the best seeds for you.",
        {
          "text": "My sister Senna left with the mill. She writes every spring.",
          "when": {
            "place": "market",
            "max": 2
          }
        }
      ],
      "close": [
        "You always brighten my day!",
        "Anything you need, just ask.",
        {
          "text": "Best customer in the valley, honestly.",
          "when": {
            "place": "market",
            "min": 3
          }
        },
        {
          "text": "Every family that left is in my ledger. I've crossed out nobody.",
          "when": {
            "place": "market",
            "max": 2
          }
        }
      ],
      "rain": ["Rain means seed sales. Lovely!", "Wet boots? Wipe them on the mat."]
    },
    "gifts": [
      {
        "item": "fiber",
        "qty": 3
      }
    ],
    "giftHearts": 3,
    "perks": {
      "2": {
        "shopDiscount": 0.05
      },
      "4": {
        "shopDiscount": 0.05
      },
      "5": {
        "shopDiscount": 0.05
      }
    },
    "birthday": {
      "season": "spring",
      "day": 12
    },
