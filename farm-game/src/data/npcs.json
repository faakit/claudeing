  "finn": {
    "name": "Finn",
    "role": "friend",
    "map": "woods",
    "tx": 11,
    "ty": 17,
    "facing": "left",
    "tint": "#8fc7e8",
    "blurb": "Fishes the lake all day.",
    "loves": ["catfish", "salmon", "trout", "fish_stew"],
    "likes": ["carp", "bluegill", "perch", "blackberry"],
    "dislikes": ["parsnip", "potato"],
    "lines": {
      "stranger": [
        "Shh. You will scare the fish.",
        "Fishing is mostly waiting.",
        "Nice lake, huh?",
        {
          "text": "The Wend's a trickle in town now. Mud where the river ran.",
          "when": {
            "place": "weir",
            "max": 2
          }
        },
        {
          "text": "Hear that? The river's back. Still sounds wrong to me. Good wrong.",
          "when": {
            "place": "weir",
            "min": 3
          }
        }
      ],
      "friend": [
        "Try tapping the second it dips.",
        "Bait helps. A lot.",
        "The big ones bite in the rain.",
        {
          "text": "My dad built the Heron. She's sat on the mud for seven years.",
          "when": {
            "place": "weir",
            "max": 2
          }
        },
        {
          "text": "I still scrape her hull every spring. Habit.",
          "when": {
            "place": "weir",
            "max": 2
          }
        },
        {
          "text": "The Heron rides high again. I keep going down to check.",
          "when": {
            "place": "weir",
            "min": 3
          }
        }
      ],
      "close": [
        "Here, take some of my bait.",
        "You are getting good at this!",
        "Best catches come at dusk, friend.",
        {
          "text": "If the river ever runs full again, you're first aboard the Heron.",
          "when": {
            "place": "weir",
            "max": 2
          }
        },
        {
          "text": "Come aboard the Heron sometime. You earned the first trip.",
          "when": {
            "place": "weir",
            "min": 3
          }
        }
      ],
      "rain": ["Perfect weather. Catfish love rain.", "Rain on the lake, my favourite."]
    },
    "gifts": [
      {
        "item": "bait",
        "qty": 3
      }
    ],
    "giftHearts": 3,
    "perks": {
      "3": {
        "fishWindow": 0.04
      },
      "5": {
        "fishWindow": 0.04
      }
    },
    "birthday": {
      "season": "fall",
      "day": 5
    },
    "schedule": [
