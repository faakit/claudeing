  "clay": {
    "name": "Clay",
    "role": "rival",
    "map": "town",
    "tx": 15,
    "ty": 12,
    "facing": "left",
    "tint": "#8ab0e0",
    "blurb": "Farmer down the road. Proud.",
    "loves": ["melon", "ruby", "wine"],
    "likes": ["corn", "cauliflower", "iron_bar", "honey", "kale_salad"],
    "dislikes": ["wild_leek", "fiber"],
    "lines": {
      "stranger": [
        "Requests on that board? First come, first served.",
        "Leave a request to its last day and it is mine.",
        "Nice hoe. Mine is better.",
        {
          "text": "You'll last till the first dry summer. They all do.",
          "when": {
            "place": "seedhouse",
            "max": 2
          }
        },
        {
          "text": "Didn't ask for help. River's on my fields too, though.",
          "when": {
            "place": "weir",
            "min": 3
          }
        }
      ],
      "friend": [
        "Not bad, for a newcomer.",
        "Your melons are almost as good as mine.",
        "I saw your field. Respect.",
        {
          "text": "Fed this town alone for seven years. Nobody noticed.",
          "when": {
            "place": "seedhouse",
            "max": 2
          }
        },
        {
          "text": "My sister took her kids to the city. Smart, probably.",
          "when": {
            "place": "seedhouse",
            "max": 2
          }
        },
        {
          "text": "Didn't ask for help. River's on my fields too, though.",
          "when": {
            "place": "weir",
            "min": 3
          }
        }
      ],
      "close": [
        "Best rival a farmer could ask for.",
        "Race you to the Fair. Loser buys lunch.",
        "Honestly? You made me a better farmer.",
        {
          "text": "Five generations of Holts on that farm. It'll outlast me. Has to.",
          "when": {
            "place": "seedhouse",
            "max": 2
          }
        }
      ],
      "rain": ["Rain day. No excuses, though.", "Mud on my boots, gold in my pocket."]
