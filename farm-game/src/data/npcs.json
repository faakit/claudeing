    "events": [
      {
        "hearts": 2,
        "id": "soil",
        "title": "Know your soil",
        "lines": [
          "Ilse used to say most people rush the soil.",
          "Feed it in spring and it pays you back by fall.",
          "Here, a few sacks. She'd want you to have them."
        ],
        "reward": {
          "item": "fertilizer",
          "qty": 6
        }
      },
      {
        "hearts": 4,
        "id": "orchard",
        "title": "Grandmother's orchard",
        "lines": [
          "My grandmother planted these trees by hand.",
          "She said patience is the only real fertilizer.",
          "I want you to have this sapling."
        ],
        "reward": {
          "item": "apple_sapling",
          "qty": 1
        }
      },
      {
        "hearts": 5,
        "id": "harvest",
        "when": {
          "place": "orchard",
          "max": 2
        },
        "title": "Harvest thanks",
        "lines": [
          "I have never seen a farm come back like yours.",
          "Ilse would hardly know it. She'd be so proud.",
          "This is for you. You have earned it."
        ],
        "reward": {
          "gold": 900
        }
      },
      {
        "hearts": 5,
        "id": "harvest",
        "when": {
          "place": "orchard",
          "min": 3
