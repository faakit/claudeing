{
  "name": "farm-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:maps": "node scripts/generate-maps.mjs",
    "e2e": "node scripts/e2e.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "perf": "node scripts/perf.mjs",
    "e2e:mobile": "node scripts/e2e-mobile.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.56.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
